{
  "manifest_version": 3,
  "name": "Mine Cheater - No Guessing Hints",
  "version": "0.2.0",
  "description": "Gợi ý ô an toàn tiếp theo trong No Guessing mode trên minesweeper.online; người chơi tự bấm.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://minesweeper.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://minesweeper.online/*"
      ],
      "js": [
        "src/solver.js",
        "src/adapter.js",
        "src/planner.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
