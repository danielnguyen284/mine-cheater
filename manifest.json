{
  "manifest_version": 3,
  "name": "Mine Cheater — No Guessing Solver",
  "version": "0.1.0",
  "description": "Trợ lý logic và tự động mở các ô an toàn trong No Guessing mode trên minesweeper.online.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://minesweeper.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://minesweeper.online/*"
      ],
      "js": [
        "src/solver.js",
        "src/adapter.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
